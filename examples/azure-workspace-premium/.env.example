# Copy to .env and fill in real values. The ANTHROPIC_API_KEY is pushed into
# Azure Key Vault on first `vystak apply`; subsequent applies skip keys already
# in the vault unless --force is set. The running container never sees `.env` —
# it reads the secret from Key Vault via ACA's secretRef mechanism.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Name of an existing Azure FileStorage account (Premium_LRS SKU) used to back
# the workspace volume (Azure Files NFS share). Must be in the same region as
# the ACA environment (eastus2 by default).
AZURE_STORAGE_ACCOUNT=your-storage-account-name

# Name of an existing VNet-injected Container Apps environment. NFS mounts
# require vnetConfiguration.infrastructureSubnetId to be set, which cannot be
# added to an existing environment after the fact. Create the environment
# yourself with --infrastructure-subnet-resource-id.
AZURE_ACA_ENVIRONMENT=your-aca-environment-name
